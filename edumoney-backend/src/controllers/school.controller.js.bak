};

export const changePassword = async (req, res) => {
  try {
    const { schoolId } = req.params;
    const { currentPassword, newPassword } = req.body;

    //  Validação básica
    if (!currentPassword || !newPassword) {
      return res.status(400).send({
        message: "Preencha todos os campos",
      });
    }

    //  Validação forte da senha
    if (newPassword.length < 6) {
      return res.status(400).send({
        message: "A nova senha deve ter pelo menos 6 caracteres",
      });
    }

    if (!/[A-Z]/.test(newPassword)) {
      return res.status(400).send({
        message: "Inclua pelo menos 1 letra maiúscula",
      });
    }

    if (!/[0-9]/.test(newPassword)) {
      return res.status(400).send({
        message: "Inclua pelo menos 1 número",
      });
    }

    // 🔎 Buscar com senha
    const school = await School.findById(schoolId).select("+password");

    if (!school) {
      return res.status(404).send({
        message: "Escola não encontrada",
      });
    }

    // 🔑 Comparar senha atual
    const isMatch = await school.matchPassword(currentPassword);

    if (!isMatch) {
      return res.status(400).send({
        message: "Senha atual incorreta",
      });
    }

    // 🚫 Evitar senha igual
    const isSamePassword = await school.matchPassword(newPassword);
    if (isSamePassword) {
      return res.status(400).send({
        message: "A nova senha deve ser diferente da atual",
      });
    }

    // 🔄 Atualizar senha (hash automático via pre-save)
    school.password = newPassword;

    // 🗓 Auditoria simples
    school.passwordChangedAt = new Date();

    await school.save();

    return res.status(200).send({
      message: "Senha alterada com sucesso",
    });

  } catch (err) {
    console.error("Erro ao alterar senha:", err);

    return res.status(500).send({
      message: "Erro interno ao alterar senha",
    });
  }
};
