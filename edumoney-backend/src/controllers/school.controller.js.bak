import School from "../models/school.model.js";
import Wallet from "../models/wallet.js";
import Class from "../models/class.model.js";
import Merchant from "../models/merchant.model.js";

// Criar escola
export const createSchool = async (req, res) => {
  try {
    const { name, nif, address, password } = req.body;

    // validações
    if (!name || !nif || !address || !password) {
      return res.status(400).send({
        message: "Preencha todos os campos obrigatórios",
      });
    }

    if (!/^\d{9}$/.test(nif)) {
      return res.status(400).send({
        message: "O NIF deve conter exatamente 9 dígitos",
      });
    }

    // verificar duplicação
    const existingSchool = await School.findOne({
      $or: [{ name }, { nif }],
    });

    if (existingSchool) {
      if (existingSchool.nif === nif)
        return res.status(400).send({
          message: "Já existe uma escola cadastrada com este NIF",
        });

      if (existingSchool.name === name)
        return res.status(400).send({
          message: "Já existe uma escola cadastrada com este nome",
        });

      return res.status(400).send({
        message: "Escola já cadastrada",
      });
    }

    // cria escola
    const school = await School.create({
      name,
      nif,
      address,
      password,
    });

    // cria wallet GLOBAL
    const wallet = await Wallet.create({
      ownerId: school._id,
      ownerModel: "School",
      balance: 0,
    });

    school.walletId = wallet._id;
    await school.save();

    return res.status(201).send({
      message: "Escola e carteira criadas com sucesso!",
      school,
    });
  } catch (error) {
    console.error("Erro ao criar escola:", error);

    if (error.code === 11000) {
      const duplicatedField = Object.keys(error.keyValue)[0];

      return res.status(400).send({
        message: `Já existe uma escola cadastrada com este ${duplicatedField}`,
      });
    }

    if (error.name === "ValidationError") {
      return res.status(400).send({
        message: error.message,
      });
    }

    return res.status(500).send({
      message: "Erro interno ao criar escola",
    });
  }
};

//Actualizar dados da Escola
export const UpdateSchool = async (req, res) => {
  try {
    const { schoolId } = req.params;
    const userId = req.user?._id;

    // valida id
    if (!schoolId) {
      return res.status(400).send({
        message: "Id da escola não digitado",
      });
    }

    // segurança
    if (String(schoolId) !== String(userId)) {
      return res.status(403).send({
        message: "Não autorizado",
      });
    }

    const { phone, email, description, website } = req.body;

    // montar objeto dinâmico (performance)
    const updateData = {};

    if (phone) updateData.phone = phone;
    if (email) updateData.email = email;
    if (description) updateData.description = description;
    if (website) updateData.website = website;

    // nenhum campo enviado
    if (Object.keys(updateData).length === 0) {
      return res.status(400).send({
        message: "Digite pelo menos um campo para atualizar",
      });
    }

    // update direto (mais performático)
    const updatedSchool = await School.findByIdAndUpdate(
      schoolId,
      { $set: updateData },
      { new: true, runValidators: true },
    );

    if (!updatedSchool) {
      return res.status(404).send({
        message: "Escola não encontrada",
      });
    }

    return res.status(200).send({
      message: "Atualizado com sucesso",
      school: updatedSchool,
    });
  } catch (error) {
    console.error("Erro ao atualizar escola:", error);

    return res.status(500).send({
      message: "Erro interno ao atualizar escola",
    });
  }
};

// pegar uma escola
export const getOneSchool = async (req, res) => {
  try {
    const { schoolId } = req.params;

    const school = await School.findById(schoolId).populate("walletId");

    if (!school)
      return res.status(404).send({
        message: "Escola não encontrada",
      });

    return res.status(200).send({
      school,
      message: "Sucesso ao pegar escola",
    });
  } catch (err) {
    res.status(500).send({ message: err.message });
  }
};

// listar escolas
export const getAllSchools = async (req, res) => {
  try {
