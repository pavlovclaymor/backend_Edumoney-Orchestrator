// Adicionar folhas impressas a uma escola
export const addSheetsPrint = async (req, res) => {
  try {
    const { schoolId } = req.params;
    const { quantity } = req.body;

    if (!quantity || quantity <= 0) {
      return res.status(400).send({
        message: "Informe uma quantidade válida de folhas para adicionar",
      });
    }

    // Buscar escola
    const school = await School.findById(schoolId);
    if (!school) {
      return res.status(404).send({
        message: "Escola não encontrada",
      });
    }

    // Atualizar folhas impressas
    school.sheetsPrinted += quantity;
    await school.save();

    return res.status(200).send({
      message: `${quantity} folhas adicionadas com sucesso`,
      sheetsPrinted: school.sheetsPrinted,
    });
  } catch (err) {
    console.error("Erro ao adicionar folhas impressas:", err);
    res.status(500).send({
      message: "Erro interno ao atualizar folhas impressas",
    });
  }
};

export const getSheetsPrinted = async (req, res) => {
  try {
    const { schoolId } = req.params;

    const school = await School.findById(schoolId, "sheetsPrinted sheetsSold"); // só traz sheetsPrinted
    if (!school) {
      return res.status(404).send({
        message: "Escola não encontrada",
      });
    }

    return res.status(200).send({
      sheetsPrinted: school.sheetsPrinted,
      sheetsSold: school.sheetsSold,
    });
  } catch (err) {
    console.error("Erro ao buscar folhas impressas:", err);
    res.status(500).send({
      message: "Erro interno ao buscar folhas impressas",
    });
  }
};

// Atualizar taxa de saque (feeRate)
export const updateFeeRate = async (req, res) => {
  try {
    const { schoolId } = req.params;
    const { feeRate } = req.body;
    const userId = req.user?._id;

    // Segurança
    if (String(schoolId) !== String(userId)) {
      return res.status(403).send({
        message: "Nao autorizado",
      });
    }

    // Validacao
    if (feeRate === undefined || feeRate === null) {
      return res.status(400).send({
        message: "feeRate e obrigatorio",
      });
    }

    const feeValue = parseFloat(feeRate);

    if (isNaN(feeValue) || feeValue < 0 || feeValue > 1) {
      return res.status(400).send({
        message: "feeRate deve ser um numero entre 0 e 1 (ex: 0.025 para 2.5%)",
      });
    }

    const school = await School.findByIdAndUpdate(
      schoolId,
      { $set: { feeRate: feeValue } },
      { new: true, runValidators: true }
    );

    if (!school) {
      return res.status(404).send({
        message: "Escola nao encontrada",
      });
    }

    return res.status(200).send({
      message: "Taxa de saque atualizada com sucesso",
      feeRate: school.feeRate,
    });
  } catch (err) {
    console.error("Erro ao atualizar taxa de saque:", err);
    return res.status(500).send({
      message: "Erro interno ao atualizar taxa de saque",
    });
  }
};

